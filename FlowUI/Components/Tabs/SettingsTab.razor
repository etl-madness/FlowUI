    private string _apiPermission = "scoped";
    private string _apiDescription = string.Empty;
    private bool _apiIsActive = true;
    private readonly HashSet<string> _selectedUserGroups = new(StringComparer.OrdinalIgnoreCase);
    private string _apiUserCustomGroupsCsv = string.Empty;

    // API User Groups form state
    private string _groupName = string.Empty;
    private string _groupDescription = string.Empty;
    private readonly HashSet<string> _selectedGroupMembers = new(StringComparer.OrdinalIgnoreCase);
    private string _groupCustomMembersCsv = string.Empty;
    private readonly Dictionary<string, string> _quickGroupMemberInputs = new(StringComparer.OrdinalIgnoreCase);

    // Pipeline Groups form state
    private string _pgName = string.Empty;
    private string _pgDescription = string.Empty;
    private string _pgNamePattern = string.Empty;
    private readonly HashSet<string> _selectedGroupPipelines = new(StringComparer.OrdinalIgnoreCase);
    private string _pgCustomPipelinesCsv = string.Empty;
    private readonly Dictionary<string, string> _quickPipelineInputs = new(StringComparer.OrdinalIgnoreCase);

    // Pipeline ACLs form state
    private int _aclEditId;
    private string _aclPrincipalType = "group";
    private string _aclPrincipalName = string.Empty;
    private string _aclTargetType = "pipeline_group";
    private string _aclTargetName = string.Empty;
    private string _aclEffect = "allow";
    private string _aclDescription = string.Empty;
    private readonly HashSet<string> _selectedAclActions = new(["read", "execute"], StringComparer.OrdinalIgnoreCase);
    private string _aclSearchQuery = string.Empty;
    private string _aclEffectFilter = "all";

    // Effective Permissions Inspector state
    private string _effTargetUsername = string.Empty;
    private string _effSimulatedGroupsCsv = string.Empty;
    private string _effPipelineFilter = string.Empty;
    private string _effErrorMessage = string.Empty;
    private bool _isEvaluatingEffective;

    // Crypto settings state
    private bool _showSecureKey;
    private string _keygenProfileName = "flow_signing_key";
    private string _keygenAlgorithm = "ed25519";
    private string _keygenCommonName = "Flow Studio Signer";
    private string _keygenEmail = "devops@flow.local";
    private bool _isGeneratingKey;

    private bool CanManageUsers => Auth.CurrentPermissions.IsAdmin;
    private bool CanDeleteArtifact => Auth.CurrentPermissions.CanDelete;
    private bool CanUploadArtifact => Auth.CurrentPermissions.CanCreate || Auth.CurrentPermissions.CanUpdate;
    private int TotalArtifactCount => Studio.Pipelines.Count + Studio.Configs.Count + Studio.OptionsList.Count;

    private static string GetSignatureFormatLabel(string? sigFormat) =>
        string.IsNullOrWhiteSpace(sigFormat) ? "OPENSSL" : sigFormat.ToUpperInvariant();

    private static bool IsScopedPermission(string? perm)
    {
        if (string.IsNullOrWhiteSpace(perm)) return false;
        var norm = perm.Trim();
        return string.Equals(norm, "scoped", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(norm, "acl", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(norm, "acl-only", StringComparison.OrdinalIgnoreCase) ||
               norm.EndsWith("-strict-acl", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetRoleBadgeClass(string? perm)
    {
        if (IsScopedPermission(perm)) return "badge-warn";
        if (string.Equals(perm?.Trim(), "all", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(perm?.Trim(), "admin", StringComparison.OrdinalIgnoreCase))
        {
            return "badge-success";
        }
        return "badge-running";
    }

    private void OpenUploadModalFromArtifacts()
    {
        var targetType = _artifactTypeFilter == "all" ? "pipeline" : _artifactTypeFilter;
        Studio.OpenUploadModal(targetType);
    }

    private void JumpToPipelineAcl(string pipelineName)
    {
        _section = "api_users";
        OpenNewAclForTarget("pipeline", pipelineName);
    }

    private IEnumerable<string> GetKnownPipelineGroupNames()
    {
        return _pipelineGroups.Select(g => g.Name)
            .Concat(Studio.Pipelines.SelectMany(p => p.Groups))
            .Where(g => !string.IsNullOrWhiteSpace(g))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g, StringComparer.OrdinalIgnoreCase);
    }

    private async Task GenerateKeyProfileInSettingsAsync()
    {
        _isGeneratingKey = true;
        try
        {
            var req = new CryptoKeygenRequest
            {
                Algorithm = _keygenAlgorithm,
                CommonName = _keygenCommonName,
                Email = _keygenEmail,
                ValidDays = 365
            };
            CryptoKeygenResponse? gen = null;
            try
            {
                gen = await ApiClient.CryptoKeygenAsync(req);
            }
            catch
            {
                // Fallback to local key pair generation when API is unreachable
            }
            gen ??= Crypto.GenerateKeyPairLocal(_keygenAlgorithm, _keygenCommonName);

            var profileName = string.IsNullOrWhiteSpace(_keygenProfileName)
                ? $"key_{DateTime.Now:HHmmss}"
                : _keygenProfileName.Trim();

            var profile = new SavedCryptoKeyProfile
            {
                Name = profileName,
                Format = gen.Format,
                Algorithm = gen.Algorithm,
                PrivateKeyPem = gen.PrivateKeyPem,
                PublicKeyPem = gen.PublicKeyPem,
                CertificatePem = gen.CertificatePem,
                Fingerprint = gen.Fingerprint,
                CreatedAt = DateTime.UtcNow
            };
            Studio.UpsertSavedKeyProfile(profile);
            ActivateKeyProfileFromSettings(profile);
            Studio.ShowBanner($"Generated and saved {gen.Algorithm} key profile '{profile.Name}'.", "success");
        }
        catch (Exception ex)
        {
            Studio.ShowBanner($"Key generation failed: {ex.Message}", "error");
        }
        finally
        {
            _isGeneratingKey = false;
        }
    }

    private void ActivateKeyProfileFromSettings(SavedCryptoKeyProfile kp)
    {
        Studio.ActiveSigningKeyPem = kp.PrivateKeyPem;
        Studio.ActiveSigningCertPem = kp.CertificatePem;
        Studio.ActiveVerifyPublicKeyPem = kp.PublicKeyPem;
        Studio.ActiveVerifyCertPem = kp.CertificatePem;
        Studio.ShowBanner($"Activated key profile '{kp.Name}' ({kp.Format.ToUpperInvariant()}) for signing & verification.", "info");
    }

    private async Task DownloadKeyFileAsync(string filename, string content)
    {
        await JS.InvokeVoidAsync("flowStudio.downloadXmlFile", filename, content);
    }

    private IEnumerable<ArtifactRecord> GetFilteredArtifacts()
    {
        IEnumerable<ArtifactRecord> all = Studio.Pipelines
            .Concat(Studio.Configs)
            .Concat(Studio.OptionsList);

        if (!string.IsNullOrWhiteSpace(_artifactTypeFilter) &&
            !string.Equals(_artifactTypeFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            all = all.Where(a => string.Equals(a.Type, _artifactTypeFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_artifactPipelineGroupFilter) &&
            !string.Equals(_artifactPipelineGroupFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            if (string.Equals(_artifactPipelineGroupFilter, "__ungrouped__", StringComparison.OrdinalIgnoreCase))
            {
                all = all.Where(a => string.Equals(a.Type, "pipeline", StringComparison.OrdinalIgnoreCase) && a.Groups.Count == 0);
            }
            else
            {
                all = all.Where(a => a.Groups.Any(g => string.Equals(g, _artifactPipelineGroupFilter, StringComparison.OrdinalIgnoreCase)));
            }
        }

        if (!string.IsNullOrWhiteSpace(_artifactSearchQuery))
        {
            var q = _artifactSearchQuery.Trim();
            all = all.Where(a =>
                (a.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Type?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                a.Groups.Any(g => g.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                a.Id.ToString().Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (a.Content?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return all
            .OrderBy(a => a.Type, StringComparer.OrdinalIgnoreCase)
            .ThenBy(a => a.Name, StringComparer.OrdinalIgnoreCase);
    }

    private void ClearArtifactFilter()
    {
        _artifactSearchQuery = string.Empty;
        _artifactTypeFilter = "all";
        _artifactPipelineGroupFilter = "all";
    }

    private static string GetArtifactTypeBadge(string? type) => (type ?? string.Empty).ToLowerInvariant() switch
    {
        "config" => "badge-warn",
        "options" => "badge-success",
        _ => "badge-running"
    };

    private static string GetArtifactTypeIcon(string? type) => (type ?? string.Empty).ToLowerInvariant() switch
    {
        "config" => "⚙️",
        "options" => "🎛",
        _ => "🔀"
    };

    private async Task OpenArtifactInStudioAsync(ArtifactRecord item)
    {
        var normType = (item.Type ?? "pipeline").Trim().ToLowerInvariant();
        await Studio.LoadArtifactRecordAsync(item, normType);
        var targetTab = normType switch
        {
            "config" => "config",
            "options" => "options",
            _ => "pipeline"
        };
        await Studio.SetActiveTabAsync(targetTab);
    }

    private async Task DeleteArtifactFromTableAsync(ArtifactRecord item)
    {
        var normType = (item.Type ?? "pipeline").Trim().ToLowerInvariant();
        await Studio.DeleteArtifactAsync(normType, item);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllSettingsDataAsync();
    }

    private async Task LoadAllSettingsDataAsync()
    {
        await Studio.RefreshHealthAndArtifactsAsync();
        await LoadAccessControlListsAsync();
    }

    private async Task LoadAccessControlListsAsync()
    {
        try
        {
            _apiUsers = await ApiClient.GetApiUsersAsync();
        }
