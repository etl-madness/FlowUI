                            <thead>
                                <tr>
                                    <th style="width:170px;">Pipeline Group</th>
                                    <th style="width:130px;">Glob Pattern</th>
                                    <th style="width:190px;">Description</th>
                                    <th>Explicit / Matched Pipelines</th>
                                    <th style="width:210px;">Quick Assign</th>
                                    <th style="width:190px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_pipelineGroups.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" style="text-align:center; padding:20px; color:var(--text-muted);">
                                            No pipeline groups defined yet. Create one on the left to govern related pipelines as a unit.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var pg in _pipelineGroups)
                                    {
                                        <tr>
                                            <td><strong>🗂 @pg.Name</strong></td>
                                            <td>
                                                @if (string.IsNullOrWhiteSpace(pg.NamePattern))
                                                {
                                                    <span style="color:var(--text-muted);">—</span>
                                                }
                                                else
                                                {
                                                    <code>@pg.NamePattern</code>
                                                }
                                            </td>
                                            <td style="color:var(--text-muted);">@(string.IsNullOrWhiteSpace(pg.Description) ? "—" : pg.Description)</td>
                                            <td>
                                                @if (pg.Pipelines.Count == 0)
                                                {
                                                    <span style="color:var(--text-muted); font-size:0.76rem;">None explicitly listed</span>
