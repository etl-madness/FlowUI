                    <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:space-between;">
                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            <button type="button" class="btn" @onclick="TestViaFlowApiAsync">
                                🌐 Ping via go-flowAPI (/api/v1/db/test)
                            </button>
                            <button type="button" class="btn btn-primary" @onclick="SaveDbProfileAsync">
                                💾 @(_editProfile.Id > 0 ? "Update Profile" : "Save Profile in Session")
                            </button>
