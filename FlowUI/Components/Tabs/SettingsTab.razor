        _aclDescription = string.Empty;
        _selectedAclActions.Clear();
        _selectedAclActions.Add("read");
        _selectedAclActions.Add("execute");
    }

    private IEnumerable<PipelineAclRecord> GetFilteredAcls()
    {
        IEnumerable<PipelineAclRecord> query = _pipelineAcls;
        if (!string.IsNullOrWhiteSpace(_aclEffectFilter) &&
            !string.Equals(_aclEffectFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            query = query.Where(a => string.Equals(a.Effect, _aclEffectFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_aclSearchQuery))
        {
            var q = _aclSearchQuery.Trim();
            query = query.Where(a =>
                (a.PrincipalName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.TargetName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Permissions?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return query
            .OrderByDescending(a => string.Equals(a.Effect, "deny", StringComparison.OrdinalIgnoreCase))
            .ThenBy(a => a.PrincipalType, StringComparer.OrdinalIgnoreCase)
            .ThenBy(a => a.PrincipalName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(a => a.TargetName, StringComparer.OrdinalIgnoreCase);
    }

    private async Task SavePipelineAclAsync()
    {
        if (!CanManageUsers)
        {
            Studio.ShowBanner("Admin permission required to manage pipeline ACL rules.", "error");
            return;
        }
        if (string.IsNullOrWhiteSpace(_aclPrincipalName))
        {
            Studio.ShowBanner("Principal name (user or group) is required.", "error");
            return;
        }
        if (_aclTargetType != "*" && string.IsNullOrWhiteSpace(_aclTargetName))
        {
            Studio.ShowBanner("Target pipeline or pipeline group name is required.", "error");
            return;
        }
        if (_selectedAclActions.Count == 0)
        {
            Studio.ShowBanner("Select at least one permission action (create, read, update, delete, execute, or all).", "error");
            return;
        }

        var orderedPerms = AllAclActions.Where(a => _selectedAclActions.Contains(a));
        var rule = new PipelineAclRecord
        {
            Id = _aclEditId,
            PrincipalType = _aclPrincipalType,
            PrincipalName = _aclPrincipalName.Trim(),
            TargetType = _aclTargetType,
            TargetName = _aclTargetType == "*" ? "*" : _aclTargetName.Trim(),
            Permissions = string.Join(",", orderedPerms),
            Effect = _aclEffect,
            Description = _aclDescription
        };

        try
        {
            if (_aclEditId > 0)
            {
                await ApiClient.UpdatePipelineAclAsync(_aclEditId, rule);
                Studio.ShowBanner($"Updated pipeline ACL rule #{_aclEditId}.", "success");
            }
            else
            {
                await ApiClient.UpsertPipelineAclAsync(rule);
                Studio.ShowBanner($"Saved pipeline ACL rule for '{rule.PrincipalName}' on '{rule.TargetName}'.", "success");
            }

            ResetAclForm();
            await Auth.RefreshCurrentUserPermissionsAsync();
            await Studio.RefreshHealthAndArtifactsAsync();
            await LoadAccessControlListsAsync();
            await Studio.LogEventAsync("PIPELINE_ACLS", "SAVE_ACL", rule.TargetType, rule.TargetName, "SUCCESS", 0, null);
        }
        catch (Exception ex)
        {
            Studio.ShowBanner($"Failed saving pipeline ACL rule: {ex.Message}", "error");
        }
    }

