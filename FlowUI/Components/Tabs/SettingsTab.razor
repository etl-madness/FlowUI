                                {
                                    @foreach (var grp in _apiGroups)
                                    {
                                        <tr>
                                            <td><strong>👥 @grp.Name</strong></td>
                                            <td style="color:var(--text-muted);">@(string.IsNullOrWhiteSpace(grp.Description) ? "—" : grp.Description)</td>
                                            <td>
