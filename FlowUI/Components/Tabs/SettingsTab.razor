                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] AllAclActions = ["all", "create", "read", "update", "delete", "execute"];

    private string _section = "artifacts";
    private string _accessSubTab = "users";
    private string _artifactSearchQuery = string.Empty;
    private string _artifactTypeFilter = "all";
    private string _artifactPipelineGroupFilter = "all";

    private List<ApiUserRecord> _apiUsers = new();
    private List<ApiGroupRecord> _apiGroups = new();
    private List<PipelineGroupRecord> _pipelineGroups = new();
    private List<PipelineAclRecord> _pipelineAcls = new();
    private EffectivePermissionsResponseDto? _effectivePerms;

    private SavedDatabaseProfile _editProfile = new()
