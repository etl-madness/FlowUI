    private bool CanManageUsers => Auth.CurrentPermissions.IsAdmin;
    private bool CanDeleteArtifact => Auth.CurrentPermissions.CanDelete;
    private bool CanUploadArtifact => Auth.CurrentPermissions.CanCreate || Auth.CurrentPermissions.CanUpdate;
    private int TotalArtifactCount => Studio.Pipelines.Count + Studio.Configs.Count + Studio.OptionsList.Count;

    private IEnumerable<ArtifactRecord> GetFilteredArtifacts()
    {
        IEnumerable<ArtifactRecord> all = Studio.Pipelines
            .Concat(Studio.Configs)
            .Concat(Studio.OptionsList);

        if (!string.IsNullOrWhiteSpace(_artifactTypeFilter) &&
            !string.Equals(_artifactTypeFilter, "all", StringComparison.OrdinalIgnoreCase))
        {
            all = all.Where(a => string.Equals(a.Type, _artifactTypeFilter, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(_artifactSearchQuery))
        {
            var q = _artifactSearchQuery.Trim();
            all = all.Where(a =>
                (a.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (a.Type?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                a.Id.ToString().Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (a.Content?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return all
            .OrderBy(a => a.Type, StringComparer.OrdinalIgnoreCase)
            .ThenBy(a => a.Name, StringComparer.OrdinalIgnoreCase);
    }

    private void ClearArtifactFilter()
    {
        _artifactSearchQuery = string.Empty;
        _artifactTypeFilter = "all";
    }

    private static string GetArtifactTypeBadge(string? type) => (type ?? string.Empty).ToLowerInvariant() switch
    {
        "config" => "badge-warn",
        "options" => "badge-success",
        _ => "badge-running"
    };

    private static string GetArtifactTypeIcon(string? type) => (type ?? string.Empty).ToLowerInvariant() switch
    {
        "config" => "⚙️",
        "options" => "🎛",
        _ => "🔀"
    };

    private async Task OpenArtifactInStudioAsync(ArtifactRecord item)
    {
        var normType = (item.Type ?? "pipeline").Trim().ToLowerInvariant();
        await Studio.LoadArtifactRecordAsync(item, normType);
        var targetTab = normType switch
        {
            "config" => "config",
            "options" => "options",
            _ => "pipeline"
        };
        await Studio.SetActiveTabAsync(targetTab);
    }

    private async Task DeleteArtifactFromTableAsync(ArtifactRecord item)
    {
        var normType = (item.Type ?? "pipeline").Trim().ToLowerInvariant();
        await Studio.DeleteArtifactAsync(normType, item);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllSettingsDataAsync();
    }

    private async Task LoadAllSettingsDataAsync()
    {
        await Studio.RefreshHealthAndArtifactsAsync();
        try
        {
            _apiUsers = await ApiClient.GetApiUsersAsync();
        }
        catch
        {
            // Ignore if API is offline or user is not admin
        }
    }

    private void PopulateApiUserForm(ApiUserRecord u)
    {
        _apiUsername = u.Username;
        _apiPassword = string.Empty;
        _apiPermission = string.IsNullOrWhiteSpace(u.Permission) ? "write" : u.Permission;
        _apiDescription = u.Description;
        _apiIsActive = u.IsActive;
    }

    private void ResetApiUserForm()
    {
        _apiUsername = string.Empty;
        _apiPassword = string.Empty;
        _apiPermission = "write";
        _apiDescription = string.Empty;
        _apiIsActive = true;
    }

    private async Task SwitchAuthProviderAsync(string providerName)
    {
        if (!CanManageUsers)
        {
            Studio.ShowBanner("Admin permission required to switch authentication providers.", "error");
            return;
        }

        Auth.SetActiveProvider(providerName);
        Studio.ShowBanner($"Switched active UI Authentication Provider to '{providerName}'.", "info");
        await Studio.LogEventAsync("AUTH", "SWITCH_PROVIDER", "auth_provider", providerName, "SUCCESS", 0, null);
    }

    private async Task TestViaFlowApiAsync()
    {
        if (!Auth.CurrentPermissions.IsAdmin && !Auth.CurrentPermissions.CanExecute)
        {
            Studio.ShowBanner("Admin or Execute permission required to test database connections.", "error");
            return;
        }

        var res = await ApiClient.TestDatabaseViaApiAsync(_editProfile.ConnectionString);
        _pingResultMessage = res.Connected
            ? $"✔ go-flowAPI (/api/v1/db/test) Connected in {res.LatencyMs} ms\n  Dialect: {res.Dialect}\n  DB User: {res.DbUser}\n  SPID: {res.Spid}"
            : $"❌ go-flowAPI DB Test Failed ({res.LatencyMs} ms): {res.Error}";
        await Studio.LogEventAsync("DB", "PING_API_DB", "db_profile", _editProfile.Name, res.Connected ? "SUCCESS" : "FAILED", res.LatencyMs, res.Error);
    }

    private async Task SaveDbProfileAsync()
    {
        if (!Auth.CurrentPermissions.IsAdmin && !Auth.CurrentPermissions.CanUpdate)
        {
            Studio.ShowBanner("Admin or Update permission required to save database profiles.", "error");
            return;
        }

        try
        {
            Studio.UpsertSavedDbProfile(_editProfile);
            Studio.ShowBanner($"Saved database connection profile '{_editProfile.Name}' in session.", "success");
            await Studio.LogEventAsync("DB", "SAVE_DB_PROFILE", "db_profile", _editProfile.Name, "SUCCESS", 0, null);
        }
        catch (Exception ex)
        {
            Studio.ShowBanner($"Failed saving DB profile: {ex.Message}", "error");
        }
    }

    private async Task SaveApiUserAsync()
    {
        if (!CanManageUsers)
        {
            Studio.ShowBanner("Admin permission required to manage go-flowAPI users.", "error");
            return;
        }

        try
        {
            await ApiClient.UpsertApiUserAsync(_apiUsername, _apiPassword, _apiPermission, _apiDescription, isActive: _apiIsActive);
            await Auth.RefreshCurrentUserPermissionsAsync();
            _apiUsers = await ApiClient.GetApiUsersAsync();
            Studio.ShowBanner($"Saved go-flowAPI user '{_apiUsername}'.", "success");
            await Studio.LogEventAsync("API_USERS", "UPSERT_API_USER", "api_user", _apiUsername, "SUCCESS", 0, null);
        }
        catch (Exception ex)
        {
            Studio.ShowBanner($"Failed saving API user: {ex.Message}", "error");
        }
    }

    private async Task DeleteApiUserAsync(string username)
    {
        if (!CanManageUsers)
        {
            Studio.ShowBanner("Admin permission required to delete go-flowAPI users.", "error");
            return;
        }

        try
        {
            await ApiClient.DeleteApiUserAsync(username);
            _apiUsers = await ApiClient.GetApiUsersAsync();
            Studio.ShowBanner($"Deleted go-flowAPI user '{username}'.", "info");
            await Studio.LogEventAsync("API_USERS", "DELETE_API_USER", "api_user", username, "SUCCESS", 0, null);
        }
        catch (Exception ex)
        {
            Studio.ShowBanner($"Failed deleting API user: {ex.Message}", "error");
        }
    }
}
