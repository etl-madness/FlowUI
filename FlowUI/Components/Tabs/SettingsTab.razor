                                            <td>
                                                <div style="display:flex; gap:4px;">
                                                    <input class="form-control" style="padding:3px 7px; font-size:0.76rem;"
                                                           list="known-users-datalist"
                                                           placeholder="username..."
                                                           value="@GetQuickInput(_quickGroupMemberInputs, grp.Name)"
                                                           @oninput="e => SetQuickInput(_quickGroupMemberInputs, grp.Name, e.Value?.ToString())" />
                                                    <button type="button" class="btn btn-sm"
                                                            disabled="@(!CanManageUsers)"
                                                            @onclick="() => QuickAddGroupMemberAsync(grp.Name)">
                                                        + Add
                                                    </button>
                                                </div>
                                            </td>
                                            <td>
                                                <div style="display:flex; gap:5px; flex-wrap:wrap;">
                                                    <button type="button" class="btn btn-sm"
                                                            @onclick="() => PopulateApiGroupForm(grp)">
                                                        ✎ Edit
                                                    </button>
                                                    <button type="button" class="btn btn-sm"
                                                            disabled="@(!CanManageUsers)"
                                                            @onclick='() => OpenNewAclForPrincipal("group", grp.Name)'
                                                            title="Grant or deny pipeline permissions for this group">
                                                        🛡 +ACL
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-danger"
                                                            disabled="@(!CanManageUsers)"
                                                            @onclick="() => DeleteApiGroupAsync(grp.Name)">
                                                        ✕
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <datalist id="known-users-datalist">
                            @foreach (var u in _apiUsers)
                            {
                                <option value="@u.Username"></option>
                            }
                        </datalist>
                    </div>
                </div>
            </div>
        }
        else if (_accessSubTab == "pipeline_groups")
        {
            <div style="display:grid; grid-template-columns:410px 1fr; gap:18px;">
                <div class="panel" style="border:1px solid var(--border); border-radius:8px;">
                    <div class="panel-header">
                        <span>🗂 Upsert Pipeline Group (<code>/api/v1/pipeline-groups</code>)</span>
                    </div>
                    <div class="panel-body">
                        <p style="font-size:0.77rem; color:var(--text-muted); margin-top:0; line-height:1.4;">
                            Organize pipelines by explicit membership and/or automatic wildcard pattern (e.g. <code>fin_*</code>) so ACL rules apply to every matching pipeline automatically.
                        </p>
                        <div class="form-group">
                            <label class="form-label">Pipeline Group Name</label>
                            <input class="form-control" @bind="_pgName" placeholder="finance_etl" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Auto-Match Name Glob Pattern (optional)</label>
                            <input class="form-control" @bind="_pgNamePattern" placeholder="e.g. fin_* or *_daily" />
                            <span style="font-size:0.72rem; color:var(--text-muted);">Supports <code>*</code> and <code>?</code> wildcards (case-insensitive).</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Description</label>
                            <input class="form-control" @bind="_pgDescription" placeholder="Finance ledger &amp; close pipelines" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Explicitly Assigned Pipelines</label>
                            @if (Studio.Pipelines.Count > 0)
                            {
                                <div style="display:flex; gap:6px; flex-wrap:wrap; padding:8px; border:1px solid var(--border); border-radius:6px; max-height:135px; overflow-y:auto; margin-bottom:6px;">
                                    @foreach (var pipe in Studio.Pipelines)
                                    {
                                        var isAssigned = _selectedGroupPipelines.Contains(pipe.Name);
                                        <label style="display:inline-flex; align-items:center; gap:5px; font-size:0.78rem; padding:2px 7px; border:1px solid var(--border); border-radius:999px; cursor:pointer;">
                                            <input type="checkbox" checked="@isAssigned"
                                                   @onchange="e => ToggleSetItem(_selectedGroupPipelines, pipe.Name, e.Value)" />
                                            <span>🔀 @pipe.Name</span>
                                        </label>
                                    }
                                </div>
                            }
                            <input class="form-control"
                                   @bind="_pgCustomPipelinesCsv"
                                   placeholder="Additional pipeline names (CSV)" />
                        </div>
                        <div style="display:flex; justify-content:space-between; gap:8px;">
                            <button type="button" class="btn" @onclick="ResetPipelineGroupForm">Clear</button>
                            <button type="button" class="btn btn-primary" disabled="@(!CanManageUsers)" @onclick="SavePipelineGroupAsync">
                                💾 Save Pipeline Group
                            </button>
                        </div>
                    </div>
                </div>

                <div class="panel" style="border:1px solid var(--border); border-radius:8px;">
                    <div class="panel-header">
                        <span>Pipeline Groups (@_pipelineGroups.Count)</span>
                        <button type="button" class="btn btn-sm" @onclick="LoadAllSettingsDataAsync">🔄 Refresh</button>
                    </div>
                    <div class="panel-body" style="padding:0;">
