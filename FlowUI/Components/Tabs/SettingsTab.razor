    private async Task EvaluateEffectivePermissionsAsync()
    {
        if (_isEvaluatingEffective) return;
        _isEvaluatingEffective = true;
        _effErrorMessage = string.Empty;
        try
        {
            var targetUser = CanManageUsers && !string.IsNullOrWhiteSpace(_effTargetUsername)
                ? _effTargetUsername.Trim()
                : null;
            var simGroups = CanManageUsers && !string.IsNullOrWhiteSpace(_effSimulatedGroupsCsv)
                ? _effSimulatedGroupsCsv.Trim()
                : null;
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            _effectivePerms = await ApiClient.GetEffectivePermissionsAsync(targetUser, simGroups, cts.Token);
        }
        catch (Exception ex)
        {
            _effErrorMessage = ex.Message;
        }
        finally
        {
            _isEvaluatingEffective = false;
        }
    }

    private IEnumerable<EffectivePipelinePermissionsDto> GetFilteredEffectivePipelines()
    {
        if (_effectivePerms?.Pipelines is null) return Enumerable.Empty<EffectivePipelinePermissionsDto>();
        IEnumerable<EffectivePipelinePermissionsDto> rows = _effectivePerms.Pipelines.Where(r => r is not null);
        if (!string.IsNullOrWhiteSpace(_effPipelineFilter))
        {
            var q = _effPipelineFilter.Trim();
            rows = rows.Where(r =>
                (r.Pipeline?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.Groups?.Any(g => g?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ?? false));
        }
        return rows.OrderBy(r => r.Pipeline ?? string.Empty, StringComparer.OrdinalIgnoreCase);
    }

