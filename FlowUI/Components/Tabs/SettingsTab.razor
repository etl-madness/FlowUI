        _aclPrincipalName = acl.PrincipalName;
        _aclTargetType = string.IsNullOrWhiteSpace(acl.TargetType) ? "pipeline_group" : acl.TargetType;
        _aclTargetName = _aclTargetType == "*" ? "*" : acl.TargetName;
        _aclEffect = string.IsNullOrWhiteSpace(acl.Effect) ? "allow" : acl.Effect;
        _aclDescription = acl.Description;

        _selectedAclActions.Clear();
        foreach (var token in SplitCsv(acl.Permissions))
        {
            var norm = token.ToLowerInvariant() switch
            {
                "*" or "admin" => "all",
                "exec" or "run" => "execute",
                "write" or "edit" => "update",
                _ => token.ToLowerInvariant()
            };
            _selectedAclActions.Add(norm);
        }
    }

