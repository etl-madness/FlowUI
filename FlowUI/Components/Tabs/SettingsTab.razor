                                                    <div style="display:flex; gap:5px; flex-wrap:wrap;">
                                                        @foreach (var pipeName in pg.Pipelines)
                                                        {
                                                            <span class="section-badge" style="display:inline-flex; align-items:center; gap:4px; font-size:0.72rem;">
                                                                <span>🔀 @pipeName</span>
                                                                @if (CanManageUsers)
                                                                {
                                                                    <button type="button"
                                                                            style="background:none; border:none; color:var(--danger, #ef4444); cursor:pointer; padding:0 2px; font-weight:700;"
                                                                            title="Remove explicit membership of @pipeName from @pg.Name"
                                                                            @onclick="() => RemovePipelineFromGroupAsync(pg.Name, pipeName)">
                                                                        ×
                                                                    </button>
                                                                }
                                                            </span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div style="display:flex; gap:4px;">
                                                    <input class="form-control" style="padding:3px 7px; font-size:0.76rem;"
                                                           list="known-pipelines-datalist"
                                                           placeholder="pipeline..."
                                                           value="@GetQuickInput(_quickPipelineInputs, pg.Name)"
                                                           @oninput="e => SetQuickInput(_quickPipelineInputs, pg.Name, e.Value?.ToString())" />
                                                    <button type="button" class="btn btn-sm"
                                                            disabled="@(!CanManageUsers)"
                                                            @onclick="() => QuickAddPipelineToGroupAsync(pg.Name)">
                                                        + Assign
                                                    </button>
                                                </div>
                                            </td>
                                            <td>
                                                <div style="display:flex; gap:5px; flex-wrap:wrap;">
                                                    <button type="button" class="btn btn-sm"
                                                            @onclick="() => PopulatePipelineGroupForm(pg)">
                                                        ✎ Edit
                                                    </button>
                                                    <button type="button" class="btn btn-sm"
                                                            disabled="@(!CanManageUsers)"
                                                            @onclick='() => OpenNewAclForTarget("pipeline_group", pg.Name)'
                                                            title="Create an ACL rule targeting this pipeline group">
                                                        🛡 +ACL
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-danger"
                                                            disabled="@(!CanManageUsers)"
                                                            @onclick="() => DeletePipelineGroupAsync(pg.Name)">
                                                        ✕
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                        <datalist id="known-pipelines-datalist">
                            @foreach (var p in Studio.Pipelines)
                            {
                                <option value="@p.Name"></option>
                            }
                        </datalist>
                    </div>
                </div>
            </div>
        }
        else if (_accessSubTab == "acls")
        {
            var filteredAcls = GetFilteredAcls().ToList();
            <div style="display:grid; grid-template-columns:420px 1fr; gap:18px;">
                <div class="panel" style="border:1px solid var(--border); border-radius:8px;">
                    <div class="panel-header">
                        <span>🛡 @(_aclEditId > 0 ? $"Edit Pipeline ACL Rule (#{_aclEditId})" : "Create / Upsert Pipeline ACL Rule")</span>
                    </div>
                    <div class="panel-body">
                        <div style="display:grid; grid-template-columns:135px 1fr; gap:8px;">
                            <div class="form-group">
                                <label class="form-label">Principal Type</label>
                                <select class="form-control" @bind="_aclPrincipalType">
                                    <option value="group">👥 Group</option>
                                    <option value="user">👤 User</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Principal Name</label>
                                <input class="form-control"
                                       list="acl-principals-datalist"
                                       @bind="_aclPrincipalName"
                                       placeholder="@(_aclPrincipalType == "group" ? "finance_analysts or DOMAIN\\Group" : "alice or DOMAIN\\alice")" />
                                <datalist id="acl-principals-datalist">
                                    @if (_aclPrincipalType == "group")
                                    {
                                        @foreach (var g in _apiGroups)
                                        {
                                            <option value="@g.Name"></option>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var u in _apiUsers)
                                        {
                                            <option value="@u.Username"></option>
                                        }
                                    }
                                </datalist>
                            </div>
                        </div>

                        <div style="display:grid; grid-template-columns:155px 1fr; gap:8px;">
                            <div class="form-group">
                                <label class="form-label">Target Scope</label>
                                <select class="form-control" value="@_aclTargetType" @onchange="OnAclTargetTypeChanged">
                                    <option value="pipeline_group">🗂 Pipeline Group</option>
                                    <option value="pipeline">🔀 Single Pipeline</option>
                                    <option value="*">🌐 All Pipelines (*)</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Target Name</label>
                                <input class="form-control"
                                       list="acl-targets-datalist"
                                       disabled="@(_aclTargetType == "*")"
                                       @bind="_aclTargetName"
                                       placeholder="@GetAclTargetPlaceholder()" />
                                <datalist id="acl-targets-datalist">
                                    @if (_aclTargetType == "pipeline_group")
                                    {
                                        @foreach (var pg in _pipelineGroups)
                                        {
                                            <option value="@pg.Name"></option>
                                        }
                                    }
                                    else if (_aclTargetType == "pipeline")
                                    {
                                        @foreach (var p in Studio.Pipelines)
                                        {
                                            <option value="@p.Name"></option>
                                        }
                                    }
                                </datalist>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Rule Effect</label>
                            <select class="form-control" @bind="_aclEffect">
                                <option value="allow">✔ ALLOW — Grant selected CRUD / Execution actions</option>
                                <option value="deny">⛔ DENY — Explicitly block actions (overrides ALLOW &amp; global role)</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Pipeline CRUD &amp; Execution Actions</label>
                            <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:6px; padding:8px; border:1px solid var(--border); border-radius:6px;">
                                @foreach (var actionName in AllAclActions)
                                {
                                    var isSelected = _selectedAclActions.Contains(actionName);
                                    <label style="display:flex; align-items:center; gap:6px; font-size:0.8rem; cursor:pointer;">
                                        <input type="checkbox" checked="@isSelected"
                                               @onchange="e => ToggleAclAction(actionName, e.Value)" />
                                        <span><code>@actionName</code></span>
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Description / Audit Note</label>
                            <input class="form-control" @bind="_aclDescription" placeholder="Allow finance analysts to read &amp; execute finance ETL" />
                        </div>

                        <div style="display:flex; justify-content:space-between; gap:8px;">
                            <button type="button" class="btn" @onclick="ResetAclForm">Clear / New</button>
                            <button type="button" class="btn btn-primary" disabled="@(!CanManageUsers)" @onclick="SavePipelineAclAsync">
                                💾 @(_aclEditId > 0 ? $"Update Rule #{_aclEditId}" : "Save ACL Rule (/api/v1/acls)")
                            </button>
                        </div>
                    </div>
                </div>

                <div class="panel" style="border:1px solid var(--border); border-radius:8px;">
                    <div class="panel-header" style="flex-wrap:wrap; gap:8px;">
                        <div>
                            <span>Granular Pipeline ACL Rules (@filteredAcls.Count of @_pipelineAcls.Count)</span>
                        </div>
                        <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                            <input class="form-control" style="width:210px;"
                                   placeholder="🔍 Filter principal or target..."
                                   @bind="_aclSearchQuery" @bind:event="oninput" />
                            <select class="form-control" style="width:130px;" @bind="_aclEffectFilter">
                                <option value="all">All Effects</option>
                                <option value="allow">✔ ALLOW</option>
                                <option value="deny">⛔ DENY</option>
                            </select>
                            <button type="button" class="btn btn-sm" @onclick="LoadAllSettingsDataAsync">🔄 Refresh</button>
                        </div>
                    </div>
                    <div style="padding:8px 12px; border-bottom:1px solid var(--border); font-size:0.75rem; color:var(--text-muted); background:rgba(59,130,246,0.06);">
                        <strong>Evaluation Precedence:</strong>
                        <code>1. Admin (all)</code> →
                        <code>2. Explicit DENY</code> →
                        <code>3. Explicit ALLOW (User + Groups across Pipeline, Pipeline Group &amp; *)</code> →
                        <code>4. Default DENY (Non-admin accounts without ACLs have no pipeline access)</code>
                    </div>
                    <div class="panel-body" style="padding:0;">
                        <table class="data-table" style="margin-top:0;">
                            <thead>
                                <tr>
                                    <th style="width:60px;">ID</th>
                                    <th style="width:95px;">Effect</th>
                                    <th style="width:190px;">Principal</th>
                                    <th style="width:210px;">Target</th>
                                    <th>Actions</th>
                                    <th>Description</th>
                                    <th style="width:135px;">Manage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (filteredAcls.Count == 0)
                                {
                                    <tr>
                                        <td colspan="7" style="text-align:center; padding:20px; color:var(--text-muted);">
                                            No pipeline ACL rules matched your filter. Add an ALLOW or DENY rule on the left.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var acl in filteredAcls)
                                    {
                                        var isDeny = string.Equals(acl.Effect, "deny", StringComparison.OrdinalIgnoreCase);
                                        <tr>
                                            <td><code>#@acl.Id</code></td>
                                            <td>
                                                <span class="badge @(isDeny ? "badge-error" : "badge-success")">
                                                    @(isDeny ? "⛔ DENY" : "✔ ALLOW")
                                                </span>
                                            </td>
                                            <td>
                                                <span style="font-size:0.74rem; color:var(--text-muted);">
                                                    @(string.Equals(acl.PrincipalType, "user", StringComparison.OrdinalIgnoreCase) ? "👤 user:" : "👥 group:")
                                                </span>
                                                <strong> @acl.PrincipalName</strong>
                                            </td>
                                            <td>
                                                @if (acl.TargetType == "*")
                                                {
                                                    <span class="badge badge-running">🌐 * (All Pipelines)</span>
                                                }
                                                else
                                                {
                                                    <span style="font-size:0.74rem; color:var(--text-muted);">
                                                        @(string.Equals(acl.TargetType, "pipeline", StringComparison.OrdinalIgnoreCase) ? "🔀 pipeline:" : "🗂 group:")
                                                    </span>
                                                    <strong> @acl.TargetName</strong>
                                                }
                                            </td>
                                            <td>
                                                <div style="display:flex; gap:4px; flex-wrap:wrap;">
                                                    @foreach (var act in SplitCsv(acl.Permissions))
                                                    {
                                                        <span class="perm-badge" style="font-size:0.68rem;">@act.ToUpperInvariant()</span>
                                                    }
                                                </div>
                                            </td>
                                            <td style="color:var(--text-muted); font-size:0.78rem;">
                                                @(string.IsNullOrWhiteSpace(acl.Description) ? "—" : acl.Description)
                                            </td>
                                            <td>
                                                <div style="display:flex; gap:5px;">
                                                    <button type="button" class="btn btn-sm"
                                                            @onclick="() => PopulateAclForm(acl)">
                                                        ✎ Edit
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-danger"
                                                            disabled="@(!CanManageUsers)"
                                                            @onclick="() => DeletePipelineAclAsync(acl.Id)">
                                                        ✕
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (_accessSubTab == "effective")
        {
            var effPipelines = GetFilteredEffectivePipelines().ToList();
            <div class="panel" style="border:1px solid var(--border); border-radius:8px;">
                <div class="panel-header" style="flex-wrap:wrap; gap:10px;">
                    <div>
                        <span>🔍 Effective Pipeline Permissions Inspector (<code>/api/v1/permissions/effective</code>)</span>
                    </div>
                    <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                        @if (CanManageUsers)
                        {
                            <input class="form-control" style="width:195px;"
                                   list="eff-users-datalist"
                                   placeholder="Target user (blank = self)"
