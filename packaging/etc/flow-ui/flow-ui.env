# ==============================================================================
# ETL Madness FlowUI (Flow Builder Studio) — Daemon Environment Configuration
# ==============================================================================
# Restrict file permissions after adding credentials:
#   chmod 0640 /etc/flow-ui/flow-ui.env
#   chown root:flowui /etc/flow-ui/flow-ui.env
#
# FlowUI is a stateless .NET 10 Blazor Server web frontend that communicates
# exclusively with go-flowAPI over HTTP/HTTPS (no direct database connection).
# ==============================================================================

# ASP.NET Core runtime environment
ASPNETCORE_ENVIRONMENT="Production"

# Explicit Kestrel listen URLs (recommended for bare-metal / reverse-proxy hosts).
# Use "http://127.0.0.1:5185" when terminating TLS in nginx/Caddy/Traefik/IIS,
# or "http://0.0.0.0:5185" for direct LAN access.
ASPNETCORE_URLS="http://0.0.0.0:5185"

# Alternative binding (used only when ASPNETCORE_URLS is unset):
# FLOW_UI_PORT="5185"
# FLOW_UI_SCHEME="https"

# Target go-flowAPI backend URL (takes precedence over FLOW_API_HOST / FLOW_API_PORT)
FLOW_API_URL="http://localhost:8080"

# Optional split host/port (used only when FLOW_API_URL is unset):
# FLOW_API_HOST="http://localhost"
# FLOW_API_PORT="8080"

# UI Authentication Mode:
#   ApiBasic — Interactive login verified against go-flowAPI BasicAuth (default)
#   Windows  — Windows Integrated / Active Directory identity passthrough
FLOW_UI_AUTH_MODE="ApiBasic"

# Optional Base64 "user:password" service token (used only when FLOW_UI_AUTH_MODE=Windows)
# FLOW_API_BASIC_AUTH=""

# Optional bootstrap admin username/password hints
# FLOW_UI_ADMIN_USER=""
# FLOW_UI_ADMIN_PASSWORD=""

# Optional Kestrel HTTPS certificate (when binding https:// in ASPNETCORE_URLS):
# ASPNETCORE_Kestrel__Certificates__Default__Path="/etc/flow-ui/flow-ui.pfx"
# ASPNETCORE_Kestrel__Certificates__Default__Password="ChangeMe!"
