#!/bin/ksh
#
# OpenBSD rc.d(8) daemon script for ETL Madness FlowUI (Flow Builder Studio).
# Installed at /etc/rc.d/flow_ui
#
# Requires a .NET 10 ASP.NET Core runtime ('dotnet') installed on the host.
# Enable and start on OpenBSD using rcctl(8):
#   doas rcctl enable flow_ui
#   doas rcctl start flow_ui
#   doas rcctl check flow_ui

daemon="/opt/flow-ui/bin/flow-ui"
daemon_user="flowui"
daemon_flags="--env-file /etc/flow-ui/flow-ui.env"

. /etc/rc.d/rc.subr

# /opt/flow-ui/bin/flow-ui execs dotnet /opt/flow-ui/app/FlowUI.dll
pexp=".*dotnet.*/opt/flow-ui/app/FlowUI\\.dll.*"
rc_bg=YES
rc_reload=NO

rc_pre() {
    install -d -o "${daemon_user}" -g "${daemon_user}" -m 0750 /var/db/flow-ui
    install -d -o "${daemon_user}" -g "${daemon_user}" -m 0750 /var/log/flow-ui
    if [ ! -f /var/log/flow-ui/flow-ui.log ]; then
        install -o "${daemon_user}" -g "${daemon_user}" -m 0640 /dev/null /var/log/flow-ui/flow-ui.log
    fi
}

rc_start() {
    rc_exec "HOME=/var/db/flow-ui DOTNET_CLI_HOME=/var/db/flow-ui ${daemon} ${daemon_flags} >>/var/log/flow-ui/flow-ui.log 2>&1"
}

rc_cmd $1
